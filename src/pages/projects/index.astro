---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

type Project = CollectionEntry<'projects'>;

const all = await getCollection('projects', ({ data }) => !data.draft);
const seriesById = new Map(
  (await getCollection('series', ({ data }) => !data.draft)).map((s) => [s.id, s])
);

const bySeries = new Map<string, Project[]>();
const standalone: Project[] = [];
for (const project of all) {
  const id = project.data.series;
  if (id) {
    bySeries.set(id, [...(bySeries.get(id) ?? []), project]);
  } else {
    standalone.push(project);
  }
}
for (const members of bySeries.values()) {
  members.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
}

// Series cards and standalone cards share one ordered list, so a standalone project can
// out-rank an arc. `order` unset means "no opinion" — those keep collection order, last.
type Card =
  | { kind: 'series'; id: string; info?: CollectionEntry<'series'>; members: Project[]; order?: number }
  | { kind: 'project'; project: Project; order?: number };

const cards: Card[] = [
  ...[...bySeries.entries()].map(([id, members]): Card => {
    const info = seriesById.get(id);
    return { kind: 'series', id, info, members, order: info?.data.order };
  }),
  ...standalone.map((project): Card => ({ kind: 'project', project, order: project.data.order })),
];
cards.sort((a, b) => (a.order ?? Infinity) - (b.order ?? Infinity));
---

<Base title="Projects — Arda Başarıcı" description="AI/ML projects by Arda Başarıcı.">
  <h1>Projects</h1>

  {
    cards.map((card) =>
      card.kind === 'series' ? (
        <div class="card">
          <h3>
            <a href={`/projects/${card.id}/`}>{card.info?.data.title ?? card.id}</a>
          </h3>
          {card.info && (
            <a class="desc-link" href={`/projects/${card.id}/`} tabindex="-1">
              <p class="desc">{card.info.data.blurb}</p>
            </a>
          )}
          <ol class="ledger">
            {card.members.map((p) => (
              <li>
                <a href={`/projects/${p.id}/`}>
                  <span class="lrow">
                    <span class="t">{p.data.title}</span>
                    {p.data.seriesRole && <small>{p.data.seriesRole}</small>}
                  </span>
                  {p.data.seriesNote && <span class="note">{p.data.seriesNote}</span>}
                </a>
              </li>
            ))}
            {(card.info?.data.roadmap ?? []).map((m) => (
              <li>
                <span class="planned">
                  <span class="lrow">
                    <span class="t">{m.title}</span>
                    <span class="tag">under construction</span>
                  </span>
                  {m.note && <span class="note">{m.note}</span>}
                </span>
              </li>
            ))}
          </ol>
          {(card.info?.data.links.app || card.info?.data.links.code) && (
            <div class="refs">
              {card.info?.data.links.app && (
                <a class="qlink" href={card.info.data.links.app} target="_blank" rel="noopener">
                  Live app
                </a>
              )}
              {card.info?.data.links.code && (
                <a class="qlink" href={card.info.data.links.code}>
                  Code
                </a>
              )}
            </div>
          )}
        </div>
      ) : (
        <div class="card">
          <h3>
            <a href={`/projects/${card.project.id}/`}>{card.project.data.title}</a>
          </h3>
          <a class="desc-link" href={`/projects/${card.project.id}/`} tabindex="-1">
            <p class="desc">{card.project.data.summary}</p>
          </a>
          <div class="refs">
            {card.project.data.links.app && (
              <a class="qlink" href={card.project.data.links.app} target="_blank" rel="noopener">
                Live app
              </a>
            )}
            {card.project.data.links.code && (
              <a class="qlink" href={card.project.data.links.code}>
                Code
              </a>
            )}
            {card.project.data.links.report && (
              <a class="qlink" href={card.project.data.links.report}>
                Report (PDF)
              </a>
            )}
          </div>
        </div>
      )
    )
  }
</Base>
